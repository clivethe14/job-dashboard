# Copy this file to .env and fill in your own SMTP credentials.
# For Gmail: use an "App Password" (not your normal password) — generate one at
# https://myaccount.google.com/apppasswords after enabling 2-Step Verification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Where per-application document folders are created (Company\Job Title\).
# Optional - defaults to D:\Documents\Job Applications
#APPLICATIONS_DIR=D:\Documents\Job Applications
